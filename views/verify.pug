extends auth_layout
block form_content
    div
        pre=info
        input(id="leased-tenant" name="leasedTenant" value=tenant hidden)

    fieldset.verification-code
        legend Enter your 6-digit verification code
        .verification-code__inputs
            each digit in [1, 2, 3, 4, 5, 6]
                label.sr-only(for=`code-${digit}`) Digit #{digit}
                input.verification-code__digit(
                    id=`code-${digit}`
                    name="codeDigits"
                    type="text"
                    inputmode="numeric"
                    pattern="[0-9]"
                    maxlength="1"
                    autocomplete= digit === 1 ? "one-time-code" : "off"
                    required
                )

    div.actions
        input(type="submit", name="verify", value="Verify", style="font-size: 16px").button
        a.button(href='#') Resend Link
