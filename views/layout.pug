    block integrations
    div.form_container#integrations-dialog(style="width: 100%; display: none; position: fixed; z-index: 100; background-color: rgba(0, 0, 0, 0.7);")
      form(id="integrations-dialog-form" style="background-color: rgba(255, 255, 255, 0.7);")
        span
            i.fas.fa-gears
            span#integrations-dialog-title(style="font-weight: bold; font-size: 18px;")=" Integrations"
            i.fas.fa-x.button(onclick="closeIntegrationsDialog()", style="float: right;")
            br
        div#integrations-main(style="font-size: 18px; background-color: lightgray;")
          div#integrations-menu
            a.integrations-menu-item(onclick="showMQTTIntegrations()") MQTT
            a.integrations-menu-item(onclick="") Grafana
            a.integrations-menu-item(onclick="") TTN
          div#integrations-content(style="display: flex; flex-direction: column; align-items: center;")
              div
                  button(onclick="openNewMQTTEndpointDialog()" type="button", style="font-size: 20px")
                    i.fas.fa-circle-plus
                    span=" New MQTT Endpoint"

              fieldset(form="integrations-dialog-form" id="new-mqtt-endpoint-dialog" style="display: none;")
                  legend() MQTT Endpoint
                  div
                      label(for="new-mqtt-server-host") Server Host
                          span(style='color: red') *
                      input(type="text" id="new-mqtt-server-host" name="mqttServerHost" placeholder="mqtt://thethings.network:1883")
                      br
                      .error#mqtt-server-host-error=mqttServerHostError

                  div
                      label(for="new-mqtt-user-name") Username
                          span(style='color: red') *
                      input(type="text" id="new-mqtt-user-name" name="mqttUserName" placeholder="metrics@net")
                      br
                      .error#mqtt-user-name-error=mqttUserNameError

                  div
                      label(for="new-mqtt-api-key") API Key
                          span(style='color: red') *
                      input(type="password", id="new-mqtt-api-key", name="mqttAPIKey", placeholder="**********")
                      br
                      .error#mqtt-api-key-error=mqttAPIKeyError

                  div(style="display: inline-flex; gap: 20px;")
                      button#add-MQTT-endpoint(type="button", name="add", style="font-size: 20px", onclick="addMQTTEndpoint()")
                          i.fas.fa-circle-plus
                          span Add
                      button#close-new-mqtt-endpoint-dialog(type="button", name="add", style="font-size: 20px", onclick="closeNewMQTTEndpointDialog()")
                          i.fas.fa-x
                          span Close

          div#project-details

          div#new-device-dialog(style="display: none; flex-direction: column; align-items: center;")
              p(style="font-weight: bold; font-size: 20px;") New Device
              div
                  label(for="new-device-eui") Device EUI
                      span(style='color: red') *
                      br
                  input(type="text", id="new-device-eui", name="deviceEUI", placeholder="a840419f7189b847")
                  br
                  .error#new-device-eui-error=deviceEUIError

              div
                  label(for="new-device-id") Device ID
                      span(style='color: red') *
                      br
                  input(type="text", id="new-device-id", name="deviceEUI", placeholder="ID as in TTN")
                  br
                  .error#new-device-id-error=deviceIDError


              div
                  label(for="new-device-type") Device Type
                      span(style='color: red') *
                      br
                  select(id="new-device-type", name="deviceType")
                      option(value="HTS", selected) Humidity and Temperature
                      option(value="DS") Door Sensor
                  br
                  .error#new-device-type-error=deviceTypeError

              div
                  label(for="new-device-name") Device Name
                      span(style='color: red') *
                      br
                  input(type="text", id="new-device-name", name="deviceName", placeholder="eg. Door XYZ")
                  br
                  .error#new-device-name-error=deviceNameError

              div
                  label(for="new-device-gateway") Gateway/Tower
                      span(style='color: red') *
                      br
                  select(id="new-device-gateway", name="gateway")
                  br
                  .error#new-device-gateway-error=gatewayError

              div(style="display: inline-flex; gap: 20px;")
                  button#exit-device(type="button", name="exit-device", style="font-size: 30px", onclick="backToProject()")
                      i.fas.fa-arrow-left
                  button#create-device(type="button", name="add", style="font-size: 30px", onclick="addDevice()")
                      i.fas.fa-circle-plus

          div#member-details(style="display: none; flex-direction: column; align-items: center;")
              p(style="font-weight: bold; font-size: 20px;") Manage Member
              div
                  label(for="memberEmail") Email
                      span(style='color: red') *
                      br
                  input(type="text", id="memberEmail", name="memberEmail", placeholder="user@copcart.com")
                  br
                  .error#memberEmailError=memberEmailError

              div
                  label(for="role") Role
                      span(style='color: red') *
                      br
                  select(id="role", name="role")
                      option(value=0x35) Admin
                      option(value=0x02, selected) Member(Read Only Access)
                  br
                  .error#roleError=roleError

              div(style="display: inline-flex; gap: 20px;")
                  button#exit-member(type="button", name="exit-member", style="font-size: 30px", onclick="backToProject()")
                      i.fas.fa-arrow-left
                  button#invite-member(type="button", name="add", style="font-size: 30px", onclick="inviteMember()")
                      i.fas.fa-user-plus
                  button#edit-member(type="button", name="add", style="font-size: 30px", onclick="editMember()")
                      i.fas.fa-user-pen
                  button#delete-member(type="button", name="add", style="font-size: 30px", onclick="deleteMember()")
                      i.fas.fa-trash-can

    header
      nav.navbar
        a.navbar_item
          img(src="/images/copcart.png", alt="CopCart")
        span#project-selection()='All Projects'
        span#project-selection-id(hidden)=''
        i(onclick="showUserMenu()").fas.fa-circle-user

    main#main
      div#user_menu(style="display: none; float: right;")
        span='Hi '+ firstName+','
        i(style="float: right", onclick="hideUserMenu()").fas.fa-x.button

        a.user_menu_item
          i(style="font-size: 24px;").fas.fa-circle-user
          span(style="font-weight: bold;")= ' ' +firstName + ' ' + secondName
          br
          span=email
          br
          span(style="display: none;")#user-key=userKey
          span(style="display: none;")#user-role=userRole

        a(onclick="showUserSettings()", style="font-weight: bold;").user_menu_item
          i(style="font-size: 24px;").fas.fa-gear
          span=" Settings"
        a(href='/logout', style="font-weight: bold;").user_menu_item
          i(style="font-size: 24px;").fas.fa-arrow-right-from-bracket
          span=" Log out"
          //span(style="display: inline-block; width: 100%; text-align: center;")="Log out"

      div#user_settings(style="display: none; float: right;")

        div(style="border-bottom: 2px solid black;")
          span(style="font-weight: bold;") Projects
          br
          if projects != null
            for project in projects
              - getId = 'openProjectDialog({id: \'' + project.id + '\', name: \'' + project.name+ '\', owner: \'' + project.owner + '\'})'
              span(onclick=getId).user_menu_item=project.name

          span.user_menu_item(onclick="openProjectDialog(\'" + email + "\')")='New Project'
            i.fas.fa-plus(style="float: left")


        div(style="border-bottom: 2px solid black;")
          span(style="font-weight: bold;")
            i.fas.fa-bell
            span=" Notifications"
          br
          span.user_menu_item(onclick="hideUserSettings()")
            i.fas.fa-trash-can
            span=" Clear notifications"

        span.user_menu_item(onclick="hideUserSettings()")= 'Exit Settings' + ' '
          i.fas.fa-x

      div.sidebar(style=sidebarStyle)
        a(onclick="openFilterProjectsDialog(event)").sidebar_item
          i.fas.fa-filter
          span(id="selected-project")= " All Projects"
          i.fas.fa-angle-right(style="float: right;")
        a(href='/dashboard').sidebar_item
          i.fas.fa-square-rss
          span=" Devices"
        a(href='/gateways').sidebar_item
          i.fas.fa-tower-cell
          span=" Gateways"
        a(onclick="openIntegrationsDialog()").sidebar_item
          i.fas.fa-gears
          span=" Integrations"
        a(onclick="openFilterReportsDialog(event)").sidebar_item
            i.fas.fa-chart-line
            span=" Reports"
            i.fas.fa-angle-right(style="float: right;")

      div#filter(style="display: none;").filter
          a(onclick="filterProjectDevices({id: \'\', name: \'All Projects\'})").filter-item
              span=" All Projects"
          each project in projects
              - const filterProjectDevices = `filterProjectDevices({id: \'${project.id}\', name: \'${project.name}\'})`
              a(onclick=filterProjectDevices).filter-item
                  span=" " + project.name

      div#filter-reports(style="display: none;").filter
          each project in projects
              - const filterProjectReports = `filterProjectReports({id: \'${project.id}\', name: \'${project.name}\'})`
              - const hrefItem = `/reports?id=${project.id}`
              a(onclick=filterProjectReports).filter-item
                  span=" " + project.name

      block alert
      div#alert-message(style="display: none; position: fixed; z-index: 100; background-color: red;")
        h3(style="color: rgba(255, 255, 255, 1.0);")="ERR_CONNECTION_REFUSED. Cannot establish connection to server. Please check your internet connection!"


      block content

    footer
      p © 2025 CopCart

  script(type='text/javascript', src='/javascripts/layout.js')
