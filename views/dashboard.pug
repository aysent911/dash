    script(type='text/javascript', src='/javascripts/report.js')
    script(type='text/javascript', src='/javascripts/jquery-3.7.1.min.js')
    script(type='text/javascript', src='/javascripts/GaugeMeter.js')
    script
        |   $(document).ready(function () {
        |        $('.GaugeMeter').gaugeMeter();
        |    });

