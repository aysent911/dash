extends auth_layout
block form_content

    .error=info

    div

        label(for="firstName") Preferred Name
            span(style='color: red') *
            br
        input(type="text", id="firstName", name="firstName", placeholder="Jane", value=firstName)
        br
        .error=firstNameError

    div

        label(for="email") Email
            span(style='color: red') *
            br
        input(type="text", id="email", name="email", placeholder="janedoe@org.com", value=email)
        br
        .error=emailError

    div
        label(for="password") Password
            span(style='color: red') *
            br
        input(type="password", id="password", name="password", placeholder="*****", value=pass)
        br
        .error=passwordError

    div
        label(for="confirmPassword") Confirm Password
            span(style='color: red') *
            br
        input(type="password", id="confirmPassword", name="confirmPassword", placeholder="*****", value=confirmPassword)
        br
        .error=confirmPasswordError

    div.actions
        input(type="submit", name="createAccount", value="Create Account", style="font-size: 20px").button
